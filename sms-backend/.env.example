# Copy this file to .env and fill in real values before running the server.

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:Robash24908840@localhost:5432/spms

# Secret used to sign JWTs. Use a long, random string in production —
# e.g. generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=004eb192b9643095476bbe15b8aa4c259c2d0a61c435fd53e5266fe4fa31c9a31c9b9453bb1138a6f6ce0d78bad6381b

# How long an issued JWT stays valid.
JWT_EXPIRES_IN=8h

# Port the API server listens on.
PORT=4000

# development | production
NODE_ENV=development

# Max PostgreSQL connections in the pool.
PG_POOL_MAX=10

# Comma-separated browser origins allowed in production, e.g.
# https://stock.example.edu,https://admin.example.edu
CORS_ORIGINS=https://localhost:5173

# Set true when a reverse proxy/load balancer terminates TLS before Node.
TLS_TERMINATED_BY_PROXY=false

# Required for direct Node HTTPS in production when proxy TLS is disabled.
SSL_KEY_PATH=
SSL_CERT_PATH=
